# Salin file ini jadi .env.local lalu isi nilainya.
# Jangan pernah commit .env.local (sudah di-ignore git).

# API key dari https://resend.com/api-keys — hanya dibaca di server.
RESEND_API_KEY=

# Alamat yang menerima pesan dari form kontak.
# Selama belum verifikasi domain di Resend, harus sama dengan email akun Resend.
CONTACT_TO_EMAIL=dhanesworo.md@gmail.com

# URL produksi, dipakai untuk metadata (OG/canonical). Opsional di lokal.
NEXT_PUBLIC_SITE_URL=
